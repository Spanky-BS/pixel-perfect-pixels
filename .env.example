# Public Supabase (safe to expose in the browser as the anon/publishable key)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side (never prefix with VITE_)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# AI (server only). Swap provider later without changing the job UI.
# AI_PROVIDER=lovable | openai
LOVABLE_API_KEY=
AI_PROVIDER=lovable
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=google/gemini-2.5-flash

# Drizzle / Lovable Cloud (server only)
LOVABLE_DB_MIGRATION_URL=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Richner shop session (server only — never use VITE_ prefix)
# Cookie header from an authenticated company browser session.
# Example host used in testing (override in production as needed):
# RICHNER_BASE_URL=https://baubedarf-richner.ch
RICHNER_BASE_URL=
RICHNER_COOKIE_HEADER=
# Optional AES key to decrypt rows in supplier_sessions
SUPPLIER_SESSION_SECRET=
